# ─── Switch A: dónde corre la app ───────────────────────────────
# Solo informativo/telemetría. No cambia comportamiento del código.
DEPLOY_ENV=local            # local | aws

# ─── Switch B: proveedor de voz ─────────────────────────────────
# Este SÍ cambia qué implementación de VoiceProvider se instancia.
VOICE_PROVIDER=cloud        # cloud | local

# ─── Credenciales cloud (Fase 3) ────────────────────────────────
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
GROQ_API_KEY=

# ─── Observabilidad (Fase 5) ────────────────────────────────────
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ─── MCP ────────────────────────────────────────────────────────
MCP_SERVER_URL=http://127.0.0.1:8000/mcp

# ─── Cerebro del agente (Fase 2) ────────────────────────────────
# Cualquier endpoint compatible con la API de OpenAI:
#   OpenRouter  https://openrouter.ai/api/v1     (muchos modelos, una key)
#   Groq        https://api.groq.com/openai/v1
#   Mistral     https://api.mistral.ai/v1
#   vLLM        http://localhost:8001/v1         (homelab, fases futuras)
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=liquid/lfm-2.5-2.6b:free
LLM_MODEL_RESPALDO=dots-studio/dots-3-note-preview:free
