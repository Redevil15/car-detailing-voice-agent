# ─── Switch A: dónde corre la app ───────────────────────────────
# Solo informativo/telemetría. No cambia comportamiento del código.
DEPLOY_ENV=local            # local | aws

# ─── Switch B: proveedor de voz ─────────────────────────────────
# Este SÍ cambia qué implementación de VoiceProvider se instancia.
VOICE_PROVIDER=local        # cloud | local

# ─── Credenciales cloud (Fase 3) ────────────────────────────────
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
GROQ_API_KEY=

# ─── Observabilidad (Fase 5) ────────────────────────────────────
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ─── MCP ────────────────────────────────────────────────────────
MCP_SERVER_URL=http://127.0.0.1:8000/mcp

# ─── Cerebro del agente (Fase 2) ────────────────────────────────
# Cualquier endpoint compatible con la API de OpenAI:
#   OpenRouter  https://openrouter.ai/api/v1     (muchos modelos, una key)
#   Groq        https://api.groq.com/openai/v1
#   Mistral     https://api.mistral.ai/v1
#   vLLM        http://localhost:8001/v1         (homelab, fases futuras)
# [openrouter] LLM_BASE_URL=https://openrouter.ai/api/v1
# [openrouter] LLM_API_KEY=
# [openrouter] LLM_MODEL=liquid/lfm-2.5-2.6b:free
# [openrouter] LLM_MODEL_RESPALDO=dots-studio/dots-3-note-preview:free

# ─── Voz local (Fase 3) ─────────────────────────────────────────
# Las rutas relativas se resuelven contra la raíz del repo.
WHISPER_MODEL_DIR=models/whisper-small
PIPER_VOICE=models/piper/es_MX-claude-high.onnx

# ─── LLM local con Ollama (configuración por defecto) ───────────
# Requiere Ollama corriendo y los modelos descargados:
#   ollama pull qwen3.5:2b && ollama pull lfm2.5:8b
# Ollama ignora la API key, pero la configuración exige un valor explícito.
# LLM_REASONING_EFFORT=none apaga el razonamiento oculto (0.65 s vs 1.68 s).
# Déjalo vacío con proveedores que no acepten el parámetro.
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_API_KEY=ollama-local-sin-clave
LLM_MODEL=qwen3.5:2b
LLM_MODEL_RESPALDO=lfm2.5:8b
LLM_REASONING_EFFORT=none
