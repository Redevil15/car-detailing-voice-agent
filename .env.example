# ─── Switch A: dónde corre la app ───────────────────────────────
# Solo informativo/telemetría. No cambia comportamiento del código.
DEPLOY_ENV=local            # local | aws

# ─── Switch B: proveedor de voz ─────────────────────────────────
# Este SÍ cambia qué implementación de VoiceProvider se instancia.
VOICE_PROVIDER=cloud        # cloud | local

# ─── Credenciales cloud (Fase 3) ────────────────────────────────
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
GROQ_API_KEY=

# ─── Observabilidad (Fase 5) ────────────────────────────────────
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ─── MCP ────────────────────────────────────────────────────────
MCP_SERVER_URL=http://localhost:8000/mcp
