# OJO: .dockerignore NO es .gitignore. Los patrones se evalúan contra la ruta
# completa desde la raíz del contexto, así que "*.db" solo atrapa un .db en la
# raíz. Para cualquier profundidad hace falta "**/".

# Entorno y modelos: se instalan o se montan, nunca se copian
.venv/
models/
.git/

# Bytecode compilado en la máquina de desarrollo
**/__pycache__/
**/*.py[cod]

# Secretos: las variables llegan por entorno
**/.env
**/.env.*

# Datos: jamás dentro de una imagen inmutable
**/*.db
**/*.sqlite3
**/*.wav
**/*.mp3
**/.DS_Store

# Sin uso en ejecución
docs/
sandbox/
